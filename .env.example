# Obligatoire : PostgreSQL utilisé par Prisma (copier l'URL depuis Supabase)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# JWT local pour les sessions administrateur
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="24h"

# Compte admin initial créé par `npx prisma db seed`
ADMIN_DEFAULT_EMAIL="admin@example.com"
ADMIN_DEFAULT_PASSWORD="replace-with-a-strong-password"

# Clerk : authentification des utilisateurs (facultatif si tu testes uniquement l'admin local)
CLERK_SECRET_KEY="sk_test_replace_me"
CLERK_WEBHOOK_SECRET="whsec_replace_me"

# Cloudinary : téléversement de médias
CLOUDINARY_URL="cloudinary://API_KEY:API_SECRET@CLOUD_NAME"

# Resend : envoi d'emails (facultatif)
RESEND_API_KEY="re_replace_me"
MAIL_FROM="Planoka <noreply@example.com>"

# Redis : facultatif, valeur par défaut redis://localhost:6379
REDIS_URL="redis://localhost:6379"

# Facultatif, valeur par défaut 3000
PORT=3000
NODE_ENV="development"
